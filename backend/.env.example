# PostgreSQL (либо задайте одной строкой DATABASE_URL=postgres://user:pass@host:5432/db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskuser
DB_PASSWORD=
DB_NAME=taskmanager
DB_SSL=false

JWT_SECRET=

PORT=3001
NODE_ENV=production

FRONTEND_URL=https://taskmanager.ecoestate.tv

SMTP_HOST=send.one.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Папка файлов задач (по умолчанию backend/storage/uploads — не раздаётся nginx)
# UPLOADS_DIR=
# Папка фото профиля (по умолчанию backend/storage/avatars)
# AVATARS_DIR=

# ИИ-ассистент (DeepSeek). Без ключа ассистент просто не показывается.
DEEPSEEK_API_KEY=
# Модель выбирается автоматически (быстрая «flash»); задайте, только если нужна конкретная
# DEEPSEEK_MODEL=

# MCP-сервер для ИИ (/api/mcp). Публичный адрес сайта — из него строятся адреса OAuth.
# По умолчанию берётся FRONTEND_URL; задайте, только если API доступен по другому адресу.
# MCP_PUBLIC_URL=https://taskmanager.ecoestate.tv

# Почта в MCP: ключ шифрования сохранённых паролей от почты (32 байта в base64: openssl rand -base64 32).
# Без него почта не подключается. deploy.sh создаёт его на сервере сам.
MAIL_ENCRYPTION_KEY=
# По умолчанию почта подключается для доменов с MX на one.com (imap.one.com / send.one.com).
# Другой сервер или тестовый — задать явно, вместе со списком доменов (* — любые):
# MAIL_IMAP_HOST= MAIL_IMAP_PORT=993 MAIL_IMAP_SECURE=true
# MAIL_SMTP_HOST= MAIL_SMTP_PORT=465 MAIL_SMTP_SECURE=true
# MAIL_DOMAINS=ecoestate.tv,ecosana.club

# Регистрация: с почтой из этих доменов — сразу, с остальными — по заявке, которая приходит на REGISTRATION_APPROVER_EMAIL
# REGISTRATION_OPEN_DOMAINS=ecosana.club,ecoestate.tv
# REGISTRATION_APPROVER_EMAIL=maksim.vakulenko@ecosana.club
