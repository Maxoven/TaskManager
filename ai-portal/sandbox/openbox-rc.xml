<?xml version="1.0" encoding="UTF-8"?>
<!-- Окна браузера на виртуальном экране — всегда развёрнуты, без рамок -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
  <desktops><number>1</number></desktops>
</openbox_config>
